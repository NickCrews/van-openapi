                    "null"
                  ],
                  "description": "Alpha-2 country code.",
                  "x-docs-discrepancy": "Official docs spell this field 'countyCode' \u2014 likely a typo in the docs; not yet verified live."
                }
              }
            }
          }
        }
      },
      "PersonMatchResult": {
        "type": "object",
        "required": [
          "vanId",
          "status"
        ],
        "properties": {
          "vanId": {
            "type": [
              "integer",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "description": "Matched (302 from find), Unmatched (404 from find), UnmatchedStored (201 from findOrCreate).",
            "enum": [
              "Matched",
              "Unmatched",
              "UnmatchedStored"
            ]
          }
        }
      },
