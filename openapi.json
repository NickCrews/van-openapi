          },
          "count": {
            "type": "integer"
          }
        }
      },
      "SurveyQuestion": {
        "type": "object",
        "description": "Item shape from official docs; not yet observed live (sandbox committee has no survey questions and POST /surveyQuestions rejects all type values tried so far).",
        "properties": {
