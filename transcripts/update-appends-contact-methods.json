{
  "id": "update-appends-contact-methods",
  "title": "Contact methods are appended, never replaced — and identical ones dedupe",
  "claim": "Emails, phones and addresses in an update are added to what is already there; there is no way to remove one through this endpoint. The append is idempotent for an identical value: re-sending an email the person already has does not create a second entry.",
  "spec": [
    "#/paths/~1people~1{vanId}/post"
  ],
  "render": true,
  "entries": [
    {
      "kind": "comment",
      "text": "A person with one email address."
    },
    {
      "kind": "exchange",
      "role": "setup",
      "request": {
        "method": "POST",
        "path": "/people/create",
        "url": "/people/create",
        "body": {
          "firstName": "Imani",
          "lastName": "Oyelaran-{scope}",
          "emails": [
            {
              "email": "imani.oyelaran-{scope}@example.com"
            }
          ]
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "content-type": "application/json; charset=utf-8",
          "location": "https://api.securevan.com/v4/people/100000001"
        },
        "body": {
          "vanId": 100000001,
          "status": "Stored"
        }
      }
    },
    {
      "kind": "comment",
      "text": "Update with a second address. The first is not replaced — the list grows."
    },
