{
  "id": "merge-whatif-true-simulates-without-writing",
  "title": "whatIf=true returns the completed-merge response without merging",
  "claim": "A simulation answers exactly as a real merge does — same 200, same body, same Location pointing at the primary — while both records survive. The response is therefore no evidence that a merge happened.",
  "spec": [
    "#/paths/~1people~1{vanId}~1mergeInto/put"
  ],
  "render": true,
  "entries": [
    {
      "kind": "comment",
      "text": "Two records to merge: the primary would survive, the secondary would be consumed."
    },
    {
      "kind": "exchange",
      "role": "setup",
      "request": {
        "method": "POST",
        "path": "/people/create",
        "url": "/people/create",
        "body": {
          "firstName": "Miles",
          "lastName": "Okafor-{scope}"
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "content-type": "application/json; charset=utf-8",
          "location": "https://api.securevan.com/v4/people/100000001"
        },
        "body": {
          "vanId": 100000001,
          "status": "Stored"
        }
      }
    },
    {
      "kind": "exchange",
      "role": "setup",
      "request": {
        "method": "POST",
        "path": "/people/create",
        "url": "/people/create",
        "body": {
          "firstName": "Miles",
          "lastName": "Okafor-{scope}"
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "content-type": "application/json; charset=utf-8",
          "location": "https://api.securevan.com/v4/people/100000002"
        },
        "body": {
          "vanId": 100000002,
          "status": "Stored"
        }
      }
    },
    {
      "kind": "comment",
      "text": "Simulate with the literal string `true` — the only value that suppresses the write."
    },
    {
      "kind": "exchange",
      "role": "subject",
      "request": {
        "method": "PUT",
        "path": "/people/{vanId}/mergeInto",
        "url": "/people/100000002/mergeInto?whatIf=true",
        "body": {
          "vanId": 100000001
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json; charset=utf-8",
          "location": "https://api.securevan.com/v4/people/100000001"
        },
        "body": {
          "vanId": 100000001
        }
      }
    },
    {
      "kind": "comment",
      "text": "Nothing was written: the secondary is still there, unlike after a real merge."
    },
