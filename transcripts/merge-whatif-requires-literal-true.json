{
  "id": "merge-whatif-requires-literal-true",
  "title": "whatIf only simulates for the literal string 'true'",
  "claim": "Only the exact value `true` simulates. Every other non-empty value — including `1` and `yes` — is read as false and performs the merge for real, and the response is identical either way, so nothing in it reveals which one happened.",
  "spec": [
    "#/paths/~1people~1{vanId}~1mergeInto/put"
  ],
  "render": true,
  "entries": [
    {
      "kind": "comment",
      "text": "Two records to merge: the primary survives, the secondary is consumed."
    },
    {
      "kind": "exchange",
      "role": "setup",
      "request": {
        "method": "POST",
        "path": "/people/create",
        "url": "/people/create",
        "body": {
          "firstName": "Rosa",
          "lastName": "Delgado-{scope}",
          "emails": [
            {
              "email": "rosa.delgado-{scope}@example.com"
            }
          ]
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "content-type": "application/json; charset=utf-8",
          "location": "https://api.securevan.com/v4/people/100000001"
        },
        "body": {
          "vanId": 100000001,
          "status": "Stored"
        }
      }
    },
    {
      "kind": "exchange",
      "role": "setup",
      "request": {
        "method": "POST",
        "path": "/people/create",
        "url": "/people/create",
        "body": {
          "firstName": "Rosa",
          "lastName": "Delgado-{scope}",
          "emails": [
            {
              "email": "rdelgado-{scope}@example.com"
            }
          ]
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "content-type": "application/json; charset=utf-8",
          "location": "https://api.securevan.com/v4/people/100000002"
        },
        "body": {
          "vanId": 100000002,
          "status": "Stored"
        }
      }
    },
    {
      "kind": "comment",
      "text": "Ask for a simulation with whatIf=yes — truthy in every language a caller might write this in. The 200 below is exactly what a real simulation returns."
    },
    {
      "kind": "exchange",
      "role": "subject",
      "request": {
        "method": "PUT",
        "path": "/people/{vanId}/mergeInto",
        "url": "/people/100000002/mergeInto?whatIf=yes",
        "body": {
          "vanId": 100000001
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json; charset=utf-8",
          "location": "https://api.securevan.com/v4/people/100000001"
        },
        "body": {
          "vanId": 100000001
        }
      }
    },
    {
      "kind": "comment",
      "text": "But nothing was simulated. The secondary is gone for good — only the literal string `true` suppresses the write."
    },
    {
      "kind": "exchange",
      "role": "subject",
      "request": {
        "method": "GET",
        "path": "/people/{vanId}",
        "url": "/people/100000002"
      },
      "response": {
        "status": 404,
        "headers": {
          "content-type": "application/json; charset=utf-8"
        },
        "body": {
          "errors": [
            {
              "code": "NOT_FOUND",
              "text": "The specified resource cannot be found."
            }
          ]
        }
      }
    }
  ]
}
