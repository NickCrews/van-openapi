{
  "id": "find-followed-redirect-returns-the-person",
  "title": "Following the 302 returns the whole person, not the match stub",
  "claim": "A client that follows the redirect never sees the `{vanId, status}` stub — it ends up on GET /people/{vanId} and receives the full record with 200. This only works if the client converts to GET, as fetch and browsers do; `curl -X POST -L` keeps the method and gets 411.",
  "spec": [
    "#/paths/~1people~1find/post"
  ],
  "render": true,
  "entries": [
    {
      "kind": "comment",
      "text": "A person to match, carrying enough identifiers to clear the threshold."
    },
    {
      "kind": "exchange",
      "role": "setup",
      "request": {
        "method": "POST",
        "path": "/people/create",
        "url": "/people/create",
        "body": {
          "firstName": "Harriet",
          "lastName": "Kowalski-{scope}",
          "dateOfBirth": "1975-03-14",
          "emails": [
            {
              "email": "harriet.kowalski-{scope}@example.com"
            }
          ],
          "phones": [
            {
              "phoneNumber": "9075554242"
            }
          ],
          "addresses": [
            {
              "addressLine1": "742 Evergreen Terrace",
              "city": "Springfield",
              "stateOrProvince": "AK",
              "zipOrPostalCode": "99501"
            }
          ]
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "content-type": "application/json; charset=utf-8",
          "location": "https://api.securevan.com/v4/people/100000001"
        },
        "body": {
          "vanId": 100000001,
          "status": "Stored"
        }
      }
    },
    {
      "kind": "comment",
      "text": "Same find as ever, but this client follows the redirect. The 200 below came from GET /people/{vanId} at the end of the chain, which is why it is a whole person."
    },
    {
      "kind": "exchange",
      "role": "subject",
      "request": {
        "method": "POST",
        "path": "/people/find",
        "url": "/people/find",
        "body": {
          "firstName": "Harriet",
          "lastName": "Kowalski-{scope}",
          "emails": [
            {
              "email": "harriet.kowalski-{scope}@example.com"
            }
          ]
        },
        "followRedirect": true
      },
      "response": {
        "status": 200,
