{
  "id": "merge-empty-whatif-is-rejected",
  "title": "An empty whatIf is rejected outright",
  "claim": "`?whatIf=` is the one value that neither simulates nor merges: it is refused with a bare BAD_REQUEST. Every other non-empty value performs the merge, so the empty string is the only typo here that is safe.",
  "spec": [
    "#/paths/~1people~1{vanId}~1mergeInto/put"
  ],
  "render": true,
  "entries": [
    {
      "kind": "exchange",
      "role": "setup",
      "request": {
        "method": "POST",
        "path": "/people/create",
        "url": "/people/create",
        "body": {
          "firstName": "Dana",
          "lastName": "Whitfield-{scope}"
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "content-type": "application/json; charset=utf-8",
          "location": "https://api.securevan.com/v4/people/100000001"
        },
        "body": {
          "vanId": 100000001,
          "status": "Stored"
        }
      }
    },
    {
      "kind": "exchange",
      "role": "setup",
      "request": {
        "method": "POST",
        "path": "/people/create",
        "url": "/people/create",
        "body": {
          "firstName": "Dana",
          "lastName": "Whitfield-{scope}"
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "content-type": "application/json; charset=utf-8",
          "location": "https://api.securevan.com/v4/people/100000002"
        },
        "body": {
          "vanId": 100000002,
          "status": "Stored"
        }
      }
    },
    {
      "kind": "comment",
      "text": "Send the parameter with no value. Nothing is merged and nothing is simulated."
    },
    {
      "kind": "exchange",
      "role": "subject",
      "request": {
        "method": "PUT",
        "path": "/people/{vanId}/mergeInto",
        "url": "/people/100000002/mergeInto?whatIf=",
        "body": {
          "vanId": 100000001
        }
      },
      "response": {
        "status": 400,
        "headers": {
          "content-type": "application/json; charset=utf-8"
        },
        "body": {
          "errors": [
            {
              "code": "BAD_REQUEST",
              "text": "The request is invalid."
            }
          ]
        }
      }
    },
    {
      "kind": "comment",
      "text": "Both records survive, confirming the request was refused before anything was written."
    },
