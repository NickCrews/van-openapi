{
  "id": "search-is-a-case-insensitive-prefix-match",
  "title": "Text criteria match case-insensitive prefixes, never substrings",
  "claim": "Matching runs from the start of the field, ignoring case: `wilhel` finds Wilhelmina, `helmina` finds nothing. Hits come back as full person records in the pagination envelope, with collections null unless $expand asks for them.",
  "spec": [
    "#/paths/~1people/get"
  ],
  "render": true,
  "entries": [
    {
      "kind": "comment",
      "text": "One person to search for. The scoped last name keeps other data out of the results."
    },
    {
      "kind": "exchange",
      "role": "setup",
      "request": {
        "method": "POST",
        "path": "/people/create",
        "url": "/people/create",
        "body": {
          "firstName": "Wilhelmina",
          "lastName": "Prefixling-{scope}",
          "emails": [
            {
              "email": "wilhelmina.prefixling-{scope}@example.com"
            }
          ]
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "content-type": "application/json; charset=utf-8",
          "location": "https://api.securevan.com/v4/people/100000001"
        },
        "body": {
          "vanId": 100000001,
          "status": "Stored"
        }
      }
    },
    {
      "kind": "comment",
      "text": "A lowercase prefix of the first name is enough."
    },
    {
      "kind": "exchange",
      "role": "subject",
      "request": {
