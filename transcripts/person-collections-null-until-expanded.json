{
  "id": "person-collections-null-until-expanded",
  "title": "Related collections are null until $expand asks for them",
  "claim": "Emails, phones and addresses come back null — not empty — unless the request names them in $expand. Expanded, a section the person actually has is an array of entries and a section they lack is an empty array, so null always means 'not requested', never 'none'.",
  "spec": [
    "#/paths/~1people~1{vanId}/get"
  ],
  "render": true,
  "entries": [
    {
      "kind": "comment",
      "text": "A person with one email and nothing else."
    },
    {
      "kind": "exchange",
      "role": "setup",
      "request": {
        "method": "POST",
        "path": "/people/create",
        "url": "/people/create",
        "body": {
          "firstName": "Nadia",
          "lastName": "Okonkwo-{scope}",
          "emails": [
            {
              "email": "nadia.okonkwo-{scope}@example.com"
            }
          ]
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "content-type": "application/json; charset=utf-8",
          "location": "https://api.securevan.com/v4/people/100000001"
        },
        "body": {
          "vanId": 100000001,
          "status": "Stored"
        }
      }
    },
    {
      "kind": "comment",
      "text": "Without $expand, every collection is null — including the email we just wrote."
    },
