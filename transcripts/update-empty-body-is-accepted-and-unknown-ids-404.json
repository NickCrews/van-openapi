      "response": {
        "status": 302,
        "headers": {
          "content-type": "application/json; charset=utf-8",
          "location": "https://api.securevan.com/v4/people/100000001"
        },
        "body": {
          "vanId": 100000001,
          "status": "Matched"
        }
      }
    },
    {
      "kind": "comment",
      "text": "The record is untouched."
