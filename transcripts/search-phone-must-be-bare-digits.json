{
  "id": "search-phone-must-be-bare-digits",
  "title": "Only a bare 10-digit phone number finds anyone",
  "claim": "The comparison is against the stored 10-digit string, so `(907) 555-0137` is accepted as valid input and then silently matches no one. There is no error to catch — a formatted number just looks like a person who is not there.",
  "spec": [
    "#/paths/~1people/get"
  ],
  "render": true,
  "entries": [
    {
      "kind": "comment",
      "text": "A person reachable at one phone number."
    },
    {
      "kind": "exchange",
      "role": "setup",
      "request": {
        "method": "POST",
        "path": "/people/create",
        "url": "/people/create",
        "body": {
          "firstName": "Dashiell",
          "lastName": "Dialtest-{scope}",
          "phones": [
            {
              "phoneNumber": "9075550137"
            }
          ]
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "content-type": "application/json; charset=utf-8",
          "location": "https://api.securevan.com/v4/people/100000001"
        },
        "body": {
          "vanId": 100000001,
          "status": "Stored"
        }
      }
    },
    {
      "kind": "comment",
      "text": "Bare 10 digits: found."
    },
