    "#/paths/~1people~1{vanId}~1mergeInto/put"
  ],
  "render": true,
  "entries": [
    {
      "kind": "comment",
      "text": "Two duplicates of one person. The primary survives; the secondary is consumed."
    },
    {
      "kind": "exchange",
      "role": "setup",
      "request": {
        "method": "POST",
        "path": "/people/create",
        "url": "/people/create",
        "body": {
          "firstName": "Lena",
          "lastName": "Voss-{scope}"
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "content-type": "application/json; charset=utf-8",
          "location": "https://api.securevan.com/v4/people/100000001"
        },
        "body": {
          "vanId": 100000001,
          "status": "Stored"
        }
      }
    },
